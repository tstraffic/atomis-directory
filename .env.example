# Generated secret shared with every tenant deployment so it can heartbeat.
# Without it, /fleet and /heartbeat fail closed.
FLEET_KEY=

# Defaults to .atomis.com.au. The leading dot is load-bearing.
# ALLOWED_HOST_SUFFIX=.atomis.com.au

# Per-IP /resolve requests per minute. A depot behind one NAT shares an IP.
# RATE_LIMIT_MAX=60

# PORT=3000
